{
  "expo": {
    "name": "RecipeGen",
    "slug": "recipegen-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/recipegen_logo.png",
    "scheme": "recipegenapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.recipegenapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/recipegen_logo.png",
        "backgroundImage": "./assets/images/recipegen_logo.png",
        "monochromeImage": "./assets/images/recipegen_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.recipegenapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/recipegen_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/recipegen_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#eb805a",
          "dark": {
            "backgroundColor": "#eb805a"
          }
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/models/efficientnet.tflite"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf9d14a5-2f24-41b8-b8cf-7d59f7815bbf"
      }
    }
  }
}
